# ---- Database (Neon) ------------------------------------------------------
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/lodestar?sslmode=require"
# Direct (non-pooled) connection string, used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/lodestar?sslmode=require"

# ---- Redis (Upstash) — rate limiting. Optional locally. ------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Admin (/admin, HTTP Basic Auth) --------------------------------------
ADMIN_USER="admin"
ADMIN_PASS="change-me-to-a-long-random-string"

# ---- Vercel Cron (sent as "Authorization: Bearer $CRON_SECRET") -----------
CRON_SECRET="generate-with-openssl-rand-hex-32"

# ---- Candidate accounts (optional) -----------------------------------------
# Leave these empty and the site runs exactly as before, with sign-in hidden.
# Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Only needed when the site is not served from NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL=""
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Resume storage (private Vercel Blob store) ----------------------------
# Vercel adds these when the store is connected to the project. Without them,
# resume upload is switched off in production; locally and in tests an
# in-process store stands in.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# ---- Bot protection (Cloudflare Turnstile) — optional ---------------------
# Both must be set for the check to run. Without them the widget is hidden and
# submissions are accepted (rate limiting still applies).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Public site config ----------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://lodestar.example.com"
NEXT_PUBLIC_POST_ROLE_FORM_URL="https://forms.gle/your-employer-submission-form"
NEXT_PUBLIC_CONTACT_EMAIL="hello@lodestar.example.com"

# ---- Sentry (optional) ------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
