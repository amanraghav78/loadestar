# ---- Database (Neon) ------------------------------------------------------
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/lodestar?sslmode=require"
# Direct (non-pooled) connection string, used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/lodestar?sslmode=require"

# ---- Redis (Upstash) — rate limiting. Optional locally. ------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Admin (/admin, HTTP Basic Auth) --------------------------------------
ADMIN_USER="admin"
ADMIN_PASS="change-me-to-a-long-random-string"

# ---- Vercel Cron (sent as "Authorization: Bearer $CRON_SECRET") -----------
CRON_SECRET="generate-with-openssl-rand-hex-32"

# ---- Public site config ----------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://lodestar.example.com"
NEXT_PUBLIC_POST_ROLE_FORM_URL="https://forms.gle/your-employer-submission-form"
NEXT_PUBLIC_CONTACT_EMAIL="hello@lodestar.example.com"

# ---- Sentry (optional) ------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
